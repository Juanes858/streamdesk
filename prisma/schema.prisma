generator client {
  provider = "prisma-client-js"
  output   = "../src/infraestructura/persistencia/generado"
}

datasource db {
  provider = "postgresql"
  // La URL de conexión para Prisma CLI se configura en prisma.config.ts.
}

enum Rol {
  ADMINISTRADOR
  ASESOR
  CLIENTE
}

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  correo    String   @unique
  claveHash String
  rol       Rol      @default(CLIENTE)
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())
  cuentas Cuenta[]
  ticketsComoUsuario Ticket[] @relation("TicketUsuario")
  ticketsComoAsesor Ticket[] @relation("TicketAsesor")
}

enum EstadoCuenta {
  ACTIVA
  REPORTADA
  VENCIDA
}

model Cuenta {
  id           String       @id @default(uuid())
  usuarioId    String
  usuario      Usuario      @relation(fields: [usuarioId], references: [id])
  plataformaId String
  correo       String
  claveHash    String
  fechaInicio  DateTime
  fechaFin     DateTime
  estado       EstadoCuenta @default(ACTIVA)
  tickets      Ticket[]
}

enum EstadoTicket {
  NUEVO
  ASIGNADO
  EN_PROCESO
  ESPERA_INFORMACION
  RESUELTO
  CERRADO
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

model Ticket {
  id            String       @id @default(uuid())
  usuarioId     String
  usuario       Usuario      @relation("TicketUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  asesorId      String?
  asesor        Usuario?     @relation("TicketAsesor", fields: [asesorId], references: [id], onDelete: SetNull)
  cuentaId      String
  cuenta        Cuenta       @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  descripcion   String
  estado        EstadoTicket @default(NUEVO)
  prioridad     Prioridad    @default(MEDIA)
}
