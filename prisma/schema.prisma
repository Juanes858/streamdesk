generator client {
  provider = "prisma-client-js"
  output   = "../src/infraestructura/persistencia/generado"
}

datasource db {
  provider = "postgresql"
  // La URL de conexión para Prisma CLI se configura en prisma.config.ts.
}

enum Rol {
  SOLICITANTE
  AGENTE
  COORDINADOR
  ADMINISTRADOR
}

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  correo    String   @unique
  claveHash String
  rol       Rol      @default(SOLICITANTE)
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())
}